#!/usr/bin/env python3
"""Local, OS-authorized completion; mission IDs are not bearer credentials."""
import argparse
import json
import os
import stat
import sys
import urllib.error
import urllib.request
from pathlib import Path
from uuid import UUID


def main():
    parser = argparse.ArgumentParser(description='Complete a verified roadmap mission')
    parser.add_argument('action', choices=['complete'])
    parser.add_argument('mission_id', type=UUID)
    args = parser.parse_args()
    path = Path(os.environ.get('MISSION_CREDENTIALS', '/opt/mission-signal/data/credentials')) / f'{args.mission_id}.json'
    try:
        flags = os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0)
        fd = os.open(path, flags)
        with os.fdopen(fd) as source:
            metadata = os.fstat(source.fileno())
            if not stat.S_ISREG(metadata.st_mode) or metadata.st_mode & 0o077:
                raise ValueError('Credential permissions must be private')
            credential = json.load(source)
        if credential['id'] != str(args.mission_id):
            raise ValueError('Credential identity mismatch')
        request = urllib.request.Request(f'http://127.0.0.1:18865/v1/missions/{args.mission_id}/complete',
                                         method='POST', data=b'', headers={'Authorization': 'Bearer ' + credential['token']})
        with urllib.request.urlopen(request, timeout=10) as response:
            result = json.load(response)
        if result.get('id') != str(args.mission_id) or result.get('state') != 'COMPLETED':
            raise ValueError('Unexpected completion response')
        print(json.dumps({'id': result['id'], 'state': 'COMPLETED'}))
        return 0
    except (OSError, ValueError, KeyError, urllib.error.URLError):
        print('Completion failed. Check mission authorization and local service health.', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
